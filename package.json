{
  "name": "mandato-rappel",
  "version": "2.0.0",
  "private": true,
  "description": "Synchronise les matchs Valorant de MDR vers un calendrier iCloud (CalDAV), avec notifications push.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "sync": "tsx src/main.ts",
    "notify:test": "tsx src/main.ts --test-notification",
    "notify:failure": "tsx src/main.ts --notify-workflow-failure",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.0",
    "luxon": "^3.7.2"
  },
  "optionalDependencies": {
    "playwright": "^1.65.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
